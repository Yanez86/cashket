# Copia in .env e modifica a piacere.

# Porta sul server da cui raggiungere Cashket (http://IP-DEL-SERVER:3000)
CASHKET_PORT=3000

# Fuso orario del server
TZ=Europe/Rome

# Indirizzo pubblico HTTPS (es. il nome dato al Cloudflare Tunnel).
# Esempio: https://cashket.miodominio.it
CASHKET_BASE_URL=

# Dietro Cloudflare Tunnel o un reverse proxy: la porta risponde solo dal server stesso,
# così nessuno raggiunge Cashket in HTTP semplice scavalcando il tunnel.
# CASHKET_BIND=127.0.0.1

# Indirizzi o reti dei proxy fidati per conoscere l'indirizzo vero di chi si collega.
# Predefinito: indirizzi privati e locali. "none" = nessun proxy.
# CASHKET_TRUST_PROXY=

# Chiave che cifra i segreti nel database (es. le credenziali dell'open banking). Se vuota,
# Cashket ne genera una nel file secret.key della cartella dati.
# CASHKET_SECRET_KEY=

# LOG_LEVEL=info
